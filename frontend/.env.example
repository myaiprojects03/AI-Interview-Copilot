# Backend URL the browser talks to
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase: Connect > App Frameworks > Next.js shows both values.
# Either key name works: the newer publishable key or the legacy anon key (both are public).
# Leave both empty to run without sign-in in local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paddle: Developer tools > Authentication > Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
