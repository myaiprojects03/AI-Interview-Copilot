# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Providers: groq (free tier) or fake (no key, for offline dev/tests)
LLM_PROVIDER=groq
STT_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
# none | low | medium | high (leave empty for models without reasoning)
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional free LLM fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Postgres: Project > Connect > "Session pooler" connection string (port 5432).
# Without it, uploaded CVs/JDs are kept in memory and lost on restart.
DATABASE_URL=

# Real-time tuning
# Silence (ms) that ends an utterance. Lower = faster answers, more split questions.
VAD_SILENCE_MS=800
# Partial transcripts every N ms while the interviewer talks; each one is an extra
# Whisper request against the free-tier limit. 0 = off.
STT_PARTIAL_INTERVAL_MS=2000

# ---- Sign-in (Supabase Auth) ----
# Project Settings > API: the project URL. Tokens are checked against its public keys.
# Leave empty for local development without accounts (everyone is one dev user).
SUPABASE_URL=
# Only for older Supabase projects that still sign tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=

# ---- Billing ----
# fake = simulated plans for development (never in production); paddle = Paddle Billing.
BILLING_PROVIDER=fake
PADDLE_ENVIRONMENT=sandbox
# Paddle > Developer tools > Authentication > API keys
PADDLE_API_KEY=
# Printed by: python -m scripts.paddle_setup
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
# Paddle > Developer tools > Notifications > (your destination) > secret key
PADDLE_WEBHOOK_SECRET=
# Where users return after billing actions
APP_URL=http://localhost:3000

# ---- Admin ----
# Comma-separated emails that can open the /admin latency view.
ADMIN_EMAILS=
